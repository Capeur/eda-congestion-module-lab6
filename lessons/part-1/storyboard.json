 "question": {
  "at": "slide:5:end+0.3",
  "text": { "en": "Where does a **demand of seven** come from?", "fr": "D'où vient une **demande de sept** ?" },
  "hint": { "en": "Each net drops some wire into the tiles it touches.", "fr": "Chaque réseau dépose du fil dans les tuiles qu'il touche." },
  "options": [
   {
    "label": { "en": "All of it in one tile", "fr": "Tout dans une seule tuile" },
    "reply": { "en": "Not quite: a wide net shares its wire over every tile its box touches. Part 2 shows the split.", "fr": "Pas tout à fait : un réseau large partage son fil sur chaque tuile touchée par sa boîte. La partie 2 montre le partage." },
    "correct": false
   },
   {
    "label": { "en": "Split evenly over the touched tiles", "fr": "Partagé également entre les tuiles touchées" },
    "reply": { "en": "Right: wirelength divided by tile count. Part 2 replays it net by net.", "fr": "Exact : la longueur de fil divisée par le nombre de tuiles. La partie 2 la rejoue, réseau par réseau." },
    "correct": true
   },
   {
    "label": { "en": "A random share each time", "fr": "Une part aléatoire à chaque fois" },
    "reply": { "en": "No randomness here: the split is even and the order is fixed, so maps are reproducible.", "fr": "Aucun hasard ici : le partage est égal et l'ordre est fixé, donc les cartes sont reproductibles." },
    "correct": false
   }
  ]
 },
