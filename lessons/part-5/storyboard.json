 "question": {
  "at": "slide:28:end+0.3",
  "text": {
   "en": "You spread the cells and the **peak** fell. Should the router celebrate?",
   "fr": "Vous avez dispersé les cellules et le **pic** a baissé. Le routeur devrait-il célébrer ?"
  },
  "hint": {
   "en": "Check the total overflow too.",
   "fr": "Vérifiez d'abord le débordement total."
  },
  "options": [
   {
    "label": {
     "en": "Yes, the peak fell",
     "fr": "Oui, le pic a baissé"
    },
    "reply": {
     "en": "Only half the story: the total overflow rose from five to twenty-two, and six tiles are oversubscribed now.",
     "fr": "Seulement la moitié de l'histoire : le débordement total est monté de cinq à vingt-deux, et six tuiles sont sursaturées maintenant."
    },
    "correct": false
   },
   {
    "label": {
     "en": "No: the peak fell but the total rose",
     "fr": "Non : le pic a baissé mais le total a monté"
    },
    "reply": {
     "en": "Right: peak three point five to three point three three, total five to twenty-two, count one to six. Celebrate only when both fall.",
     "fr": "Exact : pic de trois virgule cinq à trois virgule trois trois, total de cinq à vingt-deux, compte de un à six. On ne célèbre que quand les deux baissent."
    },
    "correct": true
   },
   {
